# Generated by cratepkg 0.2.0. Run `makepkg -si` to build and install, or `makepkg -f` to only build.
pkgname=pkgshelf
pkgver=0.2.0
pkgrel=1
pkgdesc='Tiny pacman-integrated tracker for the few AUR and local packages you choose'
arch=('x86_64' 'aarch64')
url='https://github.com/lazybrar/pkgshelf'
license=('GPL-2.0-or-later')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
options=('!debug')

prepare() {
  cd "$startdir/.."
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$startdir/.."
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$startdir/.."
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release
}

package() {
  install -Dm755 "$srcdir/target/release/pkgshelf" "$pkgdir/usr/bin/pkgshelf"
  install -Dm644 "$startdir/../README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  cp -a "$startdir/overlay/." "$pkgdir/"
}
